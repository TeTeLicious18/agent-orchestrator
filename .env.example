# --- Orchestrator control plane ---------------------------------------------
# Comma separated list of API keys accepted on user/operator endpoints.
# If empty, a random development key is generated at startup and printed.
ORCH_API_KEYS=

# Token an agent must present the first time it registers itself.
ORCH_BOOTSTRAP_TOKEN=change-me-bootstrap-token

# SQLite database location (a managed SQL/Postgres DSN would go here in prod).
ORCH_DB_PATH=data/orchestrator.db

# Scheduling / liveness tuning (seconds)
ORCH_HEARTBEAT_TIMEOUT=45
ORCH_DEFAULT_TASK_TIMEOUT=900
ORCH_LEASE_SECONDS=60
ORCH_MAX_CLOCK_SKEW=300

# CORS origins for the dashboard when hosted separately.
ORCH_CORS_ORIGINS=*

# --- Microsoft Foundry model catalog ----------------------------------------
# Foundry project endpoint, e.g.
#   https://<account>.services.ai.azure.com/api/projects/<project>
# Authentication uses Entra ID (DefaultAzureCredential) - no keys required.
FOUNDRY_PROJECT_ENDPOINT=

# Offline fallback: a JSON/YAML file describing deployments. Used only when
# FOUNDRY_PROJECT_ENDPOINT is empty, so demos work without an Azure connection.
ORCH_FOUNDRY_CATALOG_FILE=

# How often the catalog is re-synced from Foundry (seconds).
ORCH_FOUNDRY_SYNC_INTERVAL=900

# Ordered preference used to break ties when several deployments satisfy a task.
ORCH_MODEL_PREFERENCE=
